---
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { experience, links } from '../data/profile';

const stories = (await getCollection('research'))
  .filter((entry) => entry.data.order <= 3)
  .sort((a, b) => a.data.order - b.data.order);
const renderedStories = await Promise.all(stories.map(async (entry) => ({
  entry,
  ...(await render(entry)),
})));
---
<Page>
  <section class="hero" aria-labelledby="intro">
    <div>
      <p class="eyebrow">Principal Applied Scientist · Microsoft</p>
      <div class="hero-title">
        <h1 id="intro">Applied science and technical leadership in AI.</h1>
        <img class="profile-photo" src="/images/danny_redback.jpg" alt="Daniel Perry" width="120" height="200" />
      </div>
      <p class="intro">I'm a Principal Applied Scientist at Microsoft, working on AI-agent evaluation and conversation analysis. Previously, I worked on production NLP at Qualtrics and model compression at Amazon Alexa AI.</p>
      <p class="hero-detail">My experience includes leading NLP projects, mentoring scientists, developing model-distillation code, and fine-tuning language models. My published research covers multilingual model efficiency, LLM evaluation, and matrix approximation.</p>
      <div class="actions">
        <a class="button" href="#work">Explore selected work <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={links.linkedin}>View LinkedIn profile</a>
      </div>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="section-heading">
      <p class="eyebrow">01 / Experience</p>
      <h2 id="experience-title">Professional experience</h2>
      <p>Applied-science roles at Microsoft, Qualtrics, and Amazon, spanning agent evaluation, production NLP, and efficient language models.</p>
    </div>
    <ol class="timeline">
      {experience.map((role) => (
        <li>
          <p class="dates">{role.dates}</p>
          <h3>{role.employer}</h3>
          <p class="role">{role.title}</p>
          <p>{role.summary}</p>
        </li>
      ))}
    </ol>
    <a class="text-link" href={links.linkedin}>View complete professional experience on LinkedIn <span aria-hidden="true">↗</span></a>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="section-heading">
      <p class="eyebrow">02 / Selected publications</p>
      <h2 id="work-title">Selected publications</h2>
    </div>
    <div class="stories">
      {renderedStories.map(({ entry, Content }) => (
        <article class="story">
          <p class="eyebrow">{entry.data.year} · {entry.data.venue}</p>
          <h3>{entry.data.title}</h3>
          <Content />
          {entry.data.url && <a class="text-link" href={entry.data.url}>Read the paper <span aria-hidden="true">↗</span></a>}
        </article>
      ))}
    </div>
    <a class="text-link section-link" href="/research/">View all research publications <span aria-hidden="true">↗</span></a>
  </section>

  <section class="research-note section" aria-labelledby="research-title">
    <div>
      <p class="eyebrow">03 / Research foundations</p>
      <h2 id="research-title">Education and research background</h2>
    </div>
    <div>
      <p class="education">Ph.D. Computing, University of Utah, 2017</p>
      <p>My dissertation, <em>Data Analysis and Visualization using Basis Selection for Matrix Approximation</em>, studied compact representations of large datasets. The work applied matrix sketching and basis selection to kernel learning, simulation science, and visualization.</p>
      <a class="text-link" href="/research/">Explore the research <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="contact" class="contact section" aria-labelledby="contact-title">
    <p class="eyebrow">04 / Contact</p>
    <h2 id="contact-title">Connect</h2>
    <p>If you'd like to connect, reach out on LinkedIn.</p>
    <a class="text-link" href={links.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a>
  </section>
</Page>
